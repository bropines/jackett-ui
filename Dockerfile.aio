# syntax=docker/dockerfile:1
# All-in-one: the stock linuxserver.io Jackett image + jackett-ui (UI and its Go server) on port 8080.
# Jackett itself is untouched (same /config, PUID/PGID, TZ). JACKETT_IMAGE picks the Jackett build.
ARG JACKETT_IMAGE=lscr.io/linuxserver/jackett:latest

FROM node:22-alpine AS ui
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM golang:1.27-alpine AS server
ARG VERSION=dev
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
COPY --from=ui /app/dist ./web/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/jackett-ui .

FROM ${JACKETT_IMAGE}
COPY --from=server /out/jackett-ui /usr/local/bin/jackett-ui
COPY deploy/aio/s6-rc.d/ /etc/s6-overlay/s6-rc.d/
RUN chmod +x /etc/s6-overlay/s6-rc.d/svc-jackett-ui/run \
 && touch /etc/s6-overlay/s6-rc.d/user/contents.d/svc-jackett-ui
# The UI server shares Jackett's /config (its settings: /config/jackett-ui.json).
ENV LISTEN=:8080 \
    JACKETT_URL=http://127.0.0.1:9117 \
    DATA_DIR=/config \
    DOTNET_gcServer=0
EXPOSE 8080 9117
HEALTHCHECK --interval=30s --timeout=5s CMD ["/usr/local/bin/jackett-ui", "healthcheck"]
LABEL org.opencontainers.image.title="jackett-ui (all-in-one)" \
      org.opencontainers.image.description="Jackett (linuxserver.io image) with jackett-ui and built-in login on port 8080" \
      org.opencontainers.image.source="https://github.com/bropines/jackett-ui"
